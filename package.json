{
  "name": "manager-digital",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "dev:server": "npm run start:dev -w server",
    "dev:client": "npm run dev -w client"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@parcel/watcher": false,
    "unrs-resolver": false
  },
  "overrides": {
    "prisma": {
      "deepmerge-ts": "8.0.2",
      "mysql2": "3.24.4"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
