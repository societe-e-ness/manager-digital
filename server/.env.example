# Copier ce fichier en .env puis renseigner les valeurs réelles.

# GENERAL
NODE_ENV=development
PORT=3000
APP_PUBLIC_URL="http://localhost:3000"

# DATABASE/SUPABASE

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/manager_digital?schema=public"
# Pour les migrations prisma
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/manager_digital?schema=public"

# INTEGRATIONS

# Chiffre les jetons des clients en BDD + signe le state OAuth.
# 32 octets en base64, à générer avec : openssl rand -base64 32
ENCRYPTION_KEY="CHANGE_ME_openssl_rand_base64_32_bytes_=="

# --- Meta (Facebook / Instagram Ads) ---
# Redirect URI à déclarer dans l'app Meta :
#   {APP_PUBLIC_URL}/integrations/oauth/callback
META_ENABLED=false
META_APP_ID=""
META_APP_SECRET=""
