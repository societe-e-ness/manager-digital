# Copier ce fichier en .env puis renseigner les valeurs réelles.

# GENERAL
NODE_ENV=development
PORT=3000
APP_PUBLIC_URL="http://localhost:3000"
# Le front (les liens magiques y mènent)
CLIENT_PUBLIC_URL="http://localhost:5173"

# DATABASE/SUPABASE

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/manager_digital?schema=public"
# Pour les migrations prisma
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/manager_digital?schema=public"

# Base dédiée aux tests HTTP (npm run test:e2e) : vidée entre chaque test.
# Doit être différente des deux URL ci-dessus et son nom doit finir par "_test".
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/manager_digital_test?schema=public"

# INTEGRATIONS

# Chiffre les jetons des clients en BDD + signe le state OAuth.
# 32 octets en base64, à générer avec : openssl rand -base64 32
ENCRYPTION_KEY="CHANGE_ME_openssl_rand_base64_32_bytes_=="

# --- Meta (Facebook / Instagram Ads) ---
# Redirect URI à déclarer dans l'app Meta :
#   {APP_PUBLIC_URL}/integrations/oauth/callback
META_ENABLED=false
META_APP_ID=""
META_APP_SECRET=""

# --- SSO auth.eness (OpenID Connect) ---
# À déclarer dans auth (service + client) :
#   redirection autorisée : {APP_PUBLIC_URL}/auth/sso/callback
#   redirection après déconnexion : {CLIENT_PUBLIC_URL}/
#   URL de back-channel logout : {APP_PUBLIC_URL}/auth/sso/backchannel
#   aucun rôle à déclarer : les droits sont gérés dans le Manager Digital
# Le secret n'est affiché qu'une fois par auth : le ranger dans Vaultwarden.
SSO_ENABLED=false
OIDC_ISSUER="https://auth.eness.fr"
OIDC_CLIENT_ID="manager-digital"
OIDC_CLIENT_SECRET=""
# La valeur affichée par auth, slash final compris
OIDC_RESOURCE=""
