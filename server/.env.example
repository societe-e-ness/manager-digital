# Copier ce fichier en .env puis renseigner les valeurs réelles.

# GENERAL
PORT=3000
APP_PUBLIC_URL="manager.eness.fr"

# DATABASE/SUPABASE

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/manager_digital?schema=public"
# Pour les migrations prisma
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/manager_digital?schema=public"

# META INTEGRATION

# Permet d'encrypter les tokens des Pages clients en BDD
ENCRYPTION_KEY="megachat3000"
# Permet de démarrer l'application avec ou sans l'intégration RS Meta
META_ENABLED=false
META_APP_ID="1234"
META_APP_SECRET="4321"
