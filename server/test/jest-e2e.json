{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.spec.json" }]
  },
  "testEnvironment": "node",
  "maxWorkers": 1,
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
