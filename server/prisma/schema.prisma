// Manager IA — socle : utilisateurs, droits, authentification, intégrations API
//
// Prisma 7 : l'URL de connexion est définie dans prisma.config.ts,
// et la connexion runtime passe par le driver adapter @prisma/adapter-pg.
//
// Conventions : champs en snake_case comme dans le DBML, noms de tables via @@map,
// enums PascalCase côté Prisma et snake_case côté PostgreSQL via @@map.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Utilisateurs, clients, sites
// ─────────────────────────────────────────────

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique // identifiant du lien magique + rapprochement à la première connexion SSO
  sso_subject String?  @unique // `sub` d'auth.eness, immuable : renseigné à la première connexion SSO
  name        String?
  type        UserType // agence ou client ; ne décide pas de la méthode de connexion (ADR 0001)
  created_at  DateTime @default(now())

  clients              UserClient[]
  packs                UserPack[]
  features             UserFeature[]
  login_tokens         LoginToken[]
  sessions             Session[]
  created_integrations Integration[]

  // "user" est un mot réservé en PostgreSQL
  @@map("users")
}

model Client {
  id         Int      @id @default(autoincrement())
  name       String
  created_at DateTime @default(now())

  sites        Site[]
  users        UserClient[]
  integrations Integration[]

  @@map("client")
}

model Site {
  id         Int      @id @default(autoincrement())
  domain     String   @unique
  client_id  Int
  created_at DateTime @default(now())

  client Client @relation(fields: [client_id], references: [id], onDelete: Cascade)

  user_packs    UserPack[]
  user_features UserFeature[]
  features      SiteFeature[]
  resources     IntegrationResource[]

  @@map("site")
}

// un utilisateur peut être rattaché à plusieurs clients
model UserClient {
  user_id   Int
  client_id Int

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  client Client @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@id([user_id, client_id])
  @@map("user_client")
}

// ─────────────────────────────────────────────
// Droits : packs, fonctionnalités, surcharges
// ─────────────────────────────────────────────

// un lot de fonctionnalités (ex : "e-commerce", "réputation")
// table prête mais pas encore alimentée en V1 : les offres commerciales ne sont pas arrêtées
model Pack {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  label String

  features PackFeature[]
  users    UserPack[]

  @@map("pack")
}

// l'unité de base des droits, au format domaine.action (reviews.read, reviews.reply…)
model Feature {
  id    Int    @id @default(autoincrement())
  slug  String @unique // nom utilisé dans le code
  label String // nom affiché dans l'interface

  packs PackFeature[]
  users UserFeature[]
  sites SiteFeature[]

  @@map("feature")
}

// les fonctionnalités incluses dans chaque pack
model PackFeature {
  pack_id    Int
  feature_id Int

  pack    Pack    @relation(fields: [pack_id], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [feature_id], references: [id], onDelete: Cascade)

  @@id([pack_id, feature_id])
  @@map("pack_feature")
}

// "tel utilisateur a tel pack sur tel site"
model UserPack {
  id      Int  @id @default(autoincrement())
  user_id Int
  pack_id Int
  site_id Int? // null = ce pack s'applique sur TOUS les sites de l'utilisateur

  user User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pack Pack  @relation(fields: [pack_id], references: [id], onDelete: Restrict) // impossible de supprimer un pack encore attribué
  site Site? @relation(fields: [site_id], references: [id], onDelete: Cascade)

  // NULL ≠ NULL en SQL : un index unique partiel WHERE site_id IS NULL est ajouté
  // à la main dans la migration (voir prisma/migrations/*_socle/migration.sql).
  @@unique([user_id, pack_id, site_id])
  @@map("user_pack")
}

// surcharges individuelles, hors packs
model UserFeature {
  id         Int           @id @default(autoincrement()) // clé technique : site_id nullable ne peut pas faire partie de la clé primaire
  user_id    Int
  feature_id Int
  site_id    Int? // null = surcharge valable sur tous les sites
  effect     FeatureEffect

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [feature_id], references: [id], onDelete: Cascade)
  site    Site?   @relation(fields: [site_id], references: [id], onDelete: Cascade)

  // Même remarque que pour user_pack : index unique partiel ajouté dans la migration.
  @@unique([user_id, feature_id, site_id])
  @@map("user_feature")
}

// modules disponibles sur un site : le plafond, ils ont le dernier mot sur les droits
model SiteFeature {
  site_id    Int
  feature_id Int

  site    Site    @relation(fields: [site_id], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [feature_id], references: [id], onDelete: Cascade)

  @@id([site_id, feature_id])
  @@map("site_feature")
}

// ─────────────────────────────────────────────
// Authentification (lien magique + sessions)
// ─────────────────────────────────────────────

// liens magiques envoyés par email (utilisateurs CLIENT uniquement)
model LoginToken {
  id         Int       @id @default(autoincrement())
  user_id    Int
  hash       String    @unique // SHA-256 du jeton : jamais stocké en clair
  expires_at DateTime // ~15 minutes
  used_at    DateTime? // usage unique : rempli dès la validation
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("login_token")
}

// commune aux deux méthodes de connexion
model Session {
  id         String      @id // hash du jeton stocké dans le cookie httpOnly
  user_id    Int
  method     LoginMethod
  expires_at DateTime // glissante, prolongée à chaque visite
  revoked_at DateTime? // permet de couper un accès immédiatement
  user_agent String?
  created_at DateTime    @default(now())

  // --- SSO uniquement (null pour un lien magique)
  sso_sid       String? // session SSO d'auth.eness : cible du back-channel logout
  id_token      String? // requis pour la déconnexion côté auth.eness (id_token_hint)
  refresh_token String? // CHIFFRÉ (AES-256-GCM) : sert à revérifier l'accès
  checked_at    DateTime? // dernière revérification auprès d'auth.eness

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([sso_sid])
  @@map("session")
}

// ─────────────────────────────────────────────
// Intégrations API (Meta pour commencer)
// ─────────────────────────────────────────────

// LA CLÉ : un accès autorisé par une personne sur son compte Meta
model Integration {
  id               Int                 @id @default(autoincrement())
  provider         IntegrationProvider
  external_user_id String // id de l'utilisateur côté fournisseur
  access_token     String // jeton utilisateur, CHIFFRÉ (AES-256-GCM)
  expires_at       DateTime? // ~60 jours pour un jeton longue durée Meta
  status           IntegrationStatus   @default(ACTIVE)
  scopes           String[] // permissions réellement accordées
  client_id        Int? // null = accès appartenant à l'agence
  created_by_id    Int // qui a fait la connexion
  created_at       DateTime            @default(now())

  client     Client? @relation(fields: [client_id], references: [id], onDelete: Cascade)
  created_by User    @relation(fields: [created_by_id], references: [id])

  resources IntegrationResource[]

  // une reconnexion met à jour la ligne existante
  @@unique([provider, external_user_id])
  @@index([status, expires_at])
  @@map("integration")
}

// LES PORTES : ce que la clé permet d'atteindre (page, compte Instagram, compte publicitaire…)
model IntegrationResource {
  id             Int          @id @default(autoincrement())
  integration_id Int
  parent_id      Int? // ex : compte Instagram rattaché à sa page Facebook
  site_id        Int? // null tant que la ressource n'est associée à aucun site
  type           ResourceType
  external_id    String // id de la ressource côté fournisseur
  name           String // nom affiché dans l'interface
  access_token   String? // jeton propre (pages Facebook uniquement), CHIFFRÉ
  metadata       Json? // infos propres au fournisseur (photo, catégorie, devise…)
  last_synced_at DateTime?
  last_error     String?

  integration Integration @relation(fields: [integration_id], references: [id], onDelete: Cascade)
  site        Site?       @relation(fields: [site_id], references: [id], onDelete: SetNull) // supprimer un site ne supprime pas la page

  parent   IntegrationResource?  @relation("ResourceParent", fields: [parent_id], references: [id], onDelete: Cascade)
  children IntegrationResource[] @relation("ResourceParent")

  @@unique([integration_id, type, external_id])
  @@map("integration_resource")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserType {
  AGENCY
  CLIENT

  @@map("user_type")
}

enum FeatureEffect {
  ADD
  REMOVE // REMOVE l'emporte sur ADD

  @@map("feature_effect")
}

enum LoginMethod {
  SSO
  MAGIC_LINK

  @@map("login_method")
}

enum IntegrationProvider {
  META

  @@map("integration_provider")
}

enum IntegrationStatus {
  ACTIVE
  EXPIRED // jeton expiré : il faut reconnecter
  REVOKED // accès retiré côté fournisseur

  @@map("integration_status")
}

enum ResourceType {
  FACEBOOK_PAGE
  INSTAGRAM_ACCOUNT
  AD_ACCOUNT

  @@map("resource_type")
}
