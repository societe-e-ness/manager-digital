@startuml 

left to right direction
actor Client as c


package " Plugin Actualités " {
    usecase "Générer par IA" as UC1 #lightgreen
    usecase "Publier des actualités sur les RS du client" as UC2 #line.bold;
    usecase "Publier des actualités sur le site WP" as UC5 #line.bold;
    usecase "Lister les diffusions des RS du client" as UC3 #line.bold;
    usecase "Adapter les contenus à l'identité du client" as UC6 #line.bold;
    usecase "Connecter ses comptes publicitaires" as UC4 #lightgrey
    
}

c --> UC2
c --> UC3
c --> UC5
c --> UC6
UC1 .> UC2 : extend

UC2 .> UC4 : include 
UC3 .> UC4 : include 


@enduml