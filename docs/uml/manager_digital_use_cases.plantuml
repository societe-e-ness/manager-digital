@startuml 

left to right direction
actor Client as c


package " Manager Digital - Integrations RS" {
    'usecase "Générer par IA" as UC1 #lightgreen
    'usecase "Publier des actualités sur les RS du client" as UC2 #line.bold;
    'usecase "Publier des actualités sur le site WP" as UC5 #line.bold;
    'usecase "Lister les diffusions des RS du client" as UC3 #line.bold;
    'usecase "Adapter les contenus à l'identité du client" as UC6 #line.bold;
    'usecase "Connecter ses comptes publicitaires" as UC4 #lightgrey

    usecase "Voir les comptes RS connectés" as uc1
    usecase "Voir les pages de RS connectées" as uc2
    usecase "Connecter ses pages de RS" as uc3
    usecase "Gérer ses connexions aux réseaux sociaux" as uc4 #lightgreen;line.bold;
    

}

c --> uc4

uc2 .> uc4 : extend
uc3 .> uc4 : extend
uc1 .> uc4 : extend

' UC2 .> UC4 : include 
' UC3 .> UC4 : include 


@enduml